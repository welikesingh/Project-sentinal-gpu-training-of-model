# SENTINEL LLM scoring server (GPU). Build from the repo root:
#   docker build -f Dockerfile.llm -t sentinel-llm .
#   docker run --rm --gpus all -p 8000:8000 -e SENTINEL_API_KEY=... \
#       -v "$PWD/output:/app/output" -v "$HOME/.cache/huggingface:/root/.cache/huggingface" \
#       sentinel-llm --run output/<run> serve --host 0.0.0.0 --port 8000
# Needs the NVIDIA Container Toolkit on the host (Hyperstack GPU images usually have it; check `docker info | grep -i nvidia`).
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_DEFAULT_TIMEOUT=300
ARG TORCH_INDEX=https://download.pytorch.org/whl/cu126
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN --mount=type=cache,target=/root/.cache/pip pip install --retries 10 --timeout 600 torch==2.8.0 --index-url ${TORCH_INDEX}
COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip pip install --retries 10 --timeout 300 -r requirements.txt
COPY sentinel ./sentinel
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s CMD curl -fs http://localhost:8000/health || exit 1
ENTRYPOINT ["python", "-m", "sentinel.infer"]
# Default: serve the run mounted at /app/output/latest (override with --run output/<run> serve ...)
CMD ["--run", "output/latest", "serve", "--host", "0.0.0.0", "--port", "8000"]
